APP_FLAVOR=dev
API_BASE_URL=https://dev-api.perfume-app.local
ORDERS_WORKER_BASE_URL=https://dev-orders-worker.perfume-app.local
AI_CHAT_WORKER_BASE_URL=https://dev-ai-worker.perfume-app.local
ADMIN_LOG_LEVEL=debug
WORKER_API_KEY=
ADMIN_USE_WORKER_ORDER_TRANSITIONS=true

# Examples:
# flutter run -d chrome --target lib/main_dev.dart
# flutter run -d chrome --target lib/main_staging.dart --dart-define=ORDERS_WORKER_BASE_URL=https://staging-orders-worker.example.com --dart-define=AI_CHAT_WORKER_BASE_URL=https://staging-ai-worker.example.com --dart-define=ADMIN_LOG_LEVEL=info --dart-define=ADMIN_USE_WORKER_ORDER_TRANSITIONS=true
# flutter run -d chrome --target lib/main_prod.dart --dart-define=ORDERS_WORKER_BASE_URL=https://orders-worker.example.com --dart-define=AI_CHAT_WORKER_BASE_URL=https://ai-worker.example.com --dart-define=ADMIN_LOG_LEVEL=warning --dart-define=WORKER_API_KEY=replace-me --dart-define=ADMIN_USE_WORKER_ORDER_TRANSITIONS=true
